# Weekly trigger for streetscape-screen-provider.service (user unit, issue #316).
[Unit]
Description=Screen Panoramax coverage across the catalog weekly

[Timer]
# Monday night Pacific. Three things pick this slot, and all matter:
#   - It is AFTER the nightly batch's latest end: 02:15 + max_batch_hours + its
#     tail (bounded by the collection unit's 30 min TimeoutStopSec) -- 14:45 at
#     12 h, 18:45 at 16 h, 22:45 at 20 h. Both take the same machine-wide
#     Panoramax host lock, so an overlap is not a race -- it is a screen that
#     exits 85 (host busy) and records nothing that week. It was 12:00 until
#     2026-09-25 and 18:00 until 2026-10 (issue #389), each inside the night it
#     was meant to avoid once max_batch_hours grew.
#   - It is DONE at least an hour before the next 02:00: 23:30 at the latest
#     plus the service's 45 min TimeoutStartSec is 00:15. 23:00 satisfies both
#     ends up to max_batch_hours ~20, and tests/test_prefreeze_unit.py pins both,
#     so a raise past that fails the suite rather than losing a week.
#   - The screen is a growth SIGNAL somebody acts on (a city crossing zero is an
#     enrolment candidate), so it lands when there is a week ahead to act in.
# Still Tuesday in UTC (06:00-07:30), so the dated row and the (date, provider)
# ledger charge do not move.
OnCalendar=Mon *-*-* 23:00:00 America/Los_Angeles
RandomizedDelaySec=30m
# A missed week is a permanent hole in the series — the provider's own history
# is not queryable backwards — so catch up on the next boot rather than skipping.
Persistent=true

[Install]
WantedBy=timers.target
