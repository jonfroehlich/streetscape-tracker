# Failure notifier for streetscape-tracker (user unit). Triggered by an OnFailure=
# hook on streetscape-tracker.service; %i is the name of the unit that failed.
# Emails the recent log via the [alerts] transport in scheduler.makelab1.toml.
# Interpreter and config match streetscape-tracker.service, which explains them.
# Install: see deploy/README.md
[Unit]
Description=Email that %i failed

[Service]
Type=oneshot
WorkingDirectory=%h/streetscape-tracker
# Same env as the main service (transport creds if the mailer needs them)
EnvironmentFile=%h/streetscape-tracker/.env
ExecStart=%h/streetscape-tracker/.venv-makelab2/bin/python -m streetscape_metadata_tracker.scheduler --config %h/streetscape-tracker/config/scheduler.makelab1.toml notify-failure

# ── Sandboxing (same rationale as streetscape-tracker.service) ─────────
# Reads logs + .env from the checkout, sends mail; no docroot access.
PrivateUsers=true
NoNewPrivileges=true
RestrictSUIDSGID=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/projects/makeabilitylab/streetscape-tracker
