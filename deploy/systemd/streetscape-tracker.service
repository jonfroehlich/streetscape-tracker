# Streetscape Tracker daily collection service (user unit).
# Install: see deploy/README.md
#
# HOST MODEL (important): jonf's $HOME is shared NFS across makelab1 AND
# makelab2, so THIS unit file, its enablement, and timers.target.wants are
# identical on both boxes — only `loginctl` linger is per-host. The scheduler
# must run on exactly ONE box (both share the same SQLite catalog on ZFS), so
# the active host is pinned two ways: ConditionHost below + linger only on the
# active box. Cutover to a different host = flip ConditionHost + move linger.
# Current active host: makelab2 (data-local on its ZFS pool; see issue #148).
[Unit]
Description=Streetscape Tracker: collect today's due cities
Wants=network-online.target
After=network-online.target
# Only ever collect on the designated host, regardless of the shared-home
# enablement above. Glob matches both the short and FQDN forms.
ConditionHost=makelab2*
# Opt-in raw safety net: email whenever this unit exits nonzero. run-due
# returns nonzero on ANY failed city, so the scheduler's own threshold email
# ([alerts] in scheduler.toml) is usually the better signal; enable this too
# only if you want a belt-and-suspenders notice on every failure/crash.
#OnFailure=streetscape-tracker-notify@%n.service

[Service]
Type=oneshot
# %h/streetscape-tracker is a symlink to the real checkout on lab storage
# (/projects/makeabilitylab/streetscape-tracker); see deploy/README.md.
WorkingDirectory=%h/streetscape-tracker
# GMAPS_API_KEY / MAPILLARY_ACCESS_TOKEN live here (repo .env format: KEY=value)
EnvironmentFile=%h/streetscape-tracker/.env
# Publish straight to the NFS-mounted docroot (no SSH) — see sync_data_to_server.sh
Environment=STREETSCAPE_PUBLISH_LOCAL=1
# Where the per-IP host locks live (issue #208). Set EXPLICITLY, and to the real
# path rather than %h, for two independent reasons — either alone would make the
# lock a silent no-op against a detached operator process:
#   1. PrivateTmp=true (below) gives this unit and its children a private /tmp,
#      so a /tmp-based lock would be invisible to anything outside the unit.
#   2. WorkingDirectory is the %h SYMLINK, and paths.get_project_root() uses
#      abspath, which does not resolve symlinks — so a scheduler child and an
#      operator shell in /projects/makeabilitylab would derive different paths.
# Any manual or detached collection on this host MUST use this same value.
Environment=STREETSCAPE_LOCK_DIR=/projects/makeabilitylab/streetscape-tracker/locks
# .venv-makelab2 is a uv-managed venv whose base CPython lives on the shared ZFS
# checkout (.tooling/), so it runs on BOTH boxes — unlike the old %h/.../.venv,
# whose base /usr/bin/python3.11 exists only on makelab1. See deploy/README.md.
# NB: --config is a global arg and MUST precede the subcommand (argparse). The
# config file is named makelab1 for historical reasons but is the single shared
# production config (paths are identical on both boxes via the shared ZFS).
ExecStart=%h/streetscape-tracker/.venv-makelab2/bin/python -m streetscape_metadata_tracker.scheduler --config %h/streetscape-tracker/config/scheduler.makelab1.toml run-due
# A full day of cities can legitimately take hours. This must stay ABOVE
# [schedule].max_batch_hours (10h) so the scheduler's own deadline is what ends
# a long night: it stops starting cities and still regenerates the aggregate and
# publishes. Reaching THIS limit instead means a SIGKILL mid-loop, which throws
# away the publish for every city already collected that night (issue #167 —
# observed 2026-07-29, when a batch died at exactly 12h and the public site went
# two days stale while the catalog kept advancing).
TimeoutStartSec=14h
# Stopping is a WIND-DOWN request, not a kill: the SIGTERM handler sets a flag,
# the loop stops launching work, and the tail still runs so the night's collected
# runs are actually published. Without this line systemd applies its 90-SECOND
# default, which cannot reach even the first of those — measured 2026-08-13:
# `systemctl stop` -> SIGTERM 06:23:28 -> SIGKILL 06:24:58 -> no tail, and that
# night's runs sat unpublished until a manual `regenerate-aggregate --publish`.
#
# What this timeout has to cover is just the TAIL, and that is a consequence of
# issue #206's code half: the stop waits on neither a city nor a channel. KillMode
# defaults to control-group, so the same SIGTERM kills the in-flight child, and
# the loop then declines to start the rest of that city's channels (the flag is
# checked between a city's channels, not only between cities). Tail components:
#   - aggregate + streetwalk manifest — 7m15s measured on the 19-city night of
#     2026-08-18; ~1.6 s on a small one
#   - driving-plan summary            — 2-20 s
#   - catalog backup                  — hard-bounded at BACKUP_TIMEOUT_S (10 min)
#   - publish rsync (7,409 published  — hard-bounded at PUBLISH_TIMEOUT_S (10 min)
#     files, 30.75 GB, measured          since #230; healthy nights measure p50
#     2026-08-20)                        12.1 s / max 25.5 s over 16 nights, and
#                                        those are UPPER bounds, not readings
#                                        (docs/experiments/publish-duration.md).
#                                        The live figure is the "Published in
#                                        N.N s" line
# 30min is roughly 2x the worst tail we have measured, and a test pins
# TimeoutStopSec above the SUM of the three bounded/measured terms above
# (600 + 435 + 600 = 1635 s) and below max_batch_hours. That sum is also the
# constraint from the other direction: PUBLISH_TIMEOUT_S cannot be raised past
# ~765 s without this directive moving first, or the publish bound gets
# SIGKILLed before it can report its own timeout — which is the pre-#230
# behaviour under a different name. Reaching this timeout at all is still a
# SIGKILL — i.e. the pre-#206 behaviour — so this can only improve on it. An
# operator who needs the batch dead immediately should `systemctl --user kill`
# rather than wait this out.
TimeoutStopSec=30min

# Anything not already captured by the scheduler's own rotating log or a child's
# per-attempt log — an uncaught traceback, an OOM kill notice, output from a
# library that writes to fd 1/2 directly. Without this it went to the journal,
# which this service account cannot read (journalctl --user reports "no journal
# files were opened due to insufficient permissions"), so a crash left nothing
# to diagnose. Real path, not the %h symlink: ProtectSystem=strict below makes
# everything outside ReadWritePaths read-only, and this file is opened inside
# that namespace. Needs systemd >= 240 for append: (makelab2 runs 252).
StandardOutput=append:/projects/makeabilitylab/streetscape-tracker/logs/streetscape_service_console.log
StandardError=inherit

# ── Sandboxing ─────────────────────────────────────────────────────────
# The job needs exactly: the checkout (data/, logs/, the SQLite catalog)
# and the NFS-mounted public docroot. Everything else is read-only.
# PrivateUsers= is required first: the mount-namespace options below are
# unavailable to user units without it (they fail with EPERM).
# Verify after the first sandboxed night:
#   journalctl --user -u streetscape-tracker.service | grep -i -m1 'permission\|read-only'
#
# RestrictSUIDSGID= must stay OFF: the publish step runs rsync with
# --chmod=D2755 (setgid dirs, so docroot files inherit the web group), and
# RestrictSUIDSGID EPERMs any chmod that sets the SGID bit — files still
# transfer but rsync exits 23, so every nightly publish reports failure
# (observed on the first live night, 2026-07-16).
#
# Known limitation: local sendmail submission is setgid and thus
# incompatible with NoNewPrivileges (which several options here imply
# anyway), so the [alerts] 'mail' transport cannot work under this
# sandbox — s-nail must be configured to speak SMTP directly instead.
PrivateUsers=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Real paths, not the %h symlink — mount namespacing resolves symlinks.
ReadWritePaths=/projects/makeabilitylab/streetscape-tracker
ReadWritePaths=/cse/web/research/makelab/public/streetscape-tracker

# ── Resource guardrails ────────────────────────────────────────────────
# This host (makelab2) is shared with other lab services AND is the lab
# fileserver (its ZFS pool is NFS-exported to other boxes), so a heavy nightly
# run could degrade NFS serving too. These STATIC caps keep it from starving
# co-tenants; the scheduler's [resource_guard] adds a DYNAMIC pre-flight backoff
# on top (lowers --connection-limit when load/RAM are already tight — issue #146).
# "Real peaks are modest" was the original rationale for 4G/8G here, and a live
# night falsified it — do not lower these back without re-measuring first.
# Measured 2026-08-18 on Ho Chi Minh City's Mapillary census (5.26M CSV rows,
# 3.69M panos): the per-run JSON tail alone peaks at 4.81 GiB and does ~16 s of
# actual work. Under MemoryHigh=4G that 16 s became >28 min of continuous
# reclaim producing no output, and the scheduler's 180-min city timeout then
# SIGKILLed the child (the same failure shape as issue #157's census half, which
# PR #202 fixed at 7.1 -> 3.2 GB — that left this TAIL as the new high-water
# mark, still above 4G, which is why it looked like a separate "aggregate-tail
# hang"). That night's cgroup read MemoryPeak=4297121792 — about 2 MiB above the
# 4G threshold, i.e. held right at it, which is what a throttled cgroup looks
# like, not a comfortable one. An interim 12G gave that measured tail ~2.5x
# headroom on top of the concurrently-live census structures.
#
# 12G still did not cover the largest cities, and MemoryHigh is the cap where
# that is expensive rather than legible. Peak scales at ~0.914 GiB per million
# CSV rows (5.26M -> 4.81 GiB measured), and the largest census in the catalog
# is Detroit's 16,569,307 rows (runs.total_points, mapillary, 2026-07-24), so it
# extrapolates to 15.1 — carried as ~15.3 GiB, rounding a floor up rather than
# down: over 12G, under MemoryMax. Crossing MemoryHigh reproduces exactly
# the failure diagnosed above — hours of silent reclaim ending in the
# scheduler's 180-min city timeout — while crossing MemoryMax is a fast OOM kill
# you can read in a log. So MemoryHigh became 20G on 2026-08-20: the extrapolated
# worst city plus ~30%, with a deliberately narrow 20->24 gap so a genuine
# runaway still reaches the hard stop quickly instead of reclaiming for hours on
# the way there. The 2026-09-02 raise below keeps that SHAPE and moves only the
# numbers.
#
# THE FLOOR PRICES A FIRST RUN, and Detroit's next run is not one. 15.3 GiB is
# one census frame plus the per-run JSON tail — the shape of 2026-07-24, which
# had no previous Mapillary run to diff against. A run that DOES have one holds
# both frames at once by construction: cli.py hands the live new frame to
# _compute_and_record_diff and still needs it afterwards for the per-run JSON,
# the diff loads the previous run's CSV alongside it, and compute_run_diff then
# builds two deduplicated copies plus a Python set of every pano_id on each side
# (~15.3M boxed strings apiece for Detroit). Unmeasured, so no multiplier is
# quoted here — but it is several times one frame, i.e. plausibly through
# MemoryMax as well as MemoryHigh. That is the LEGIBLE failure by the argument
# above, so it is not on its own a reason to move a number; it IS a reason not
# to read "worst city plus ~30%" as covering every night. Measure a diff night
# (the next Detroit collection is one) before sizing against it.
#
# Two things to keep straight about that number. It RAISES NO CEILING — the
# limit is MemoryMax and it is unchanged; MemoryHigh only moves where we start
# throttling ourselves, which is the one burden on this host that has actually
# been measured (its load is ZFS; CPU sits 97-99% idle). And ~15.3 GiB is an
# EXTRAPOLATION from one city's slope, not a measurement: capture MemoryPeak on
# a real Detroit night before treating it as settled. For scale, makelab2 has
# 188 GiB and 48 cores (checked 2026-08-20), so the caps below are ~21%/~26% of
# the box.
#
# 2026-09-02 (issue #305): 20G was NOT the comfortable number the paragraphs
# above assumed. The 2026-09-01 batch read MemoryPeak=20,267,974,656 = 18.88
# GiB, i.e. 94% of MemoryHigh -- on an ORDINARY night: one collection child at a
# time, no Detroit-scale city in the slate, nothing anyone had flagged as heavy.
# 6% headroom is the throttled shape described above waiting to happen, not a
# margin. Raised to MemoryHigh=40G / MemoryMax=48G, sized for exactly three
# things and no more:
#   - one child at the measured 18.88 GiB with ~2x headroom rather than 6%;
#   - TWO children at once, which is what [schedule].max_concurrent_channels > 1
#     makes possible (issue #240) -- ~38 GiB, still under the soft brake. Today's
#     peak is ONE child, so the concurrency raise has no headroom at 20G; this is
#     its precondition, not a workaround for it;
#   - the GSV connection_limit experiment (issue #304), which raises in-flight
#     response buffers in proportion to the limit it tests.
# It is NOT sized for the 4-of-6 host-disjoint lane ceiling (~76 GiB), and it is
# still NOT sized for a Detroit DIFF night (the unmeasured two-frame case two
# paragraphs up). Measure before assuming either.
#
# The ceiling argument is the BOX's, not the cgroup's, and free RAM is the wrong
# reading of it: makelab2 has 188 GiB, but it is also the lab fileserver and most
# of its "used" memory is ZFS ARC serving NFS to other hosts. ARC is reclaimable,
# so a bigger cap here does not fail -- it quietly costs the co-tenants cache.
# That is why this is 40G/48G rather than the 64G/80G a 4-lane night would want:
# the number is argued from a measured peak plus one doubling, not from how much
# RAM looked free on one evening.
#
# MemoryPeak is now recorded per night in the run-due summary line (issue #305),
# so `grep 'cgroup peak' logs/streetscape_scheduler.log` answers "is there
# headroom?" without an operator being logged in at the right moment -- and
# without the reading being lost when the next start creates a new cgroup. Read a
# week of those, INCLUDING a night with a 4M-point city (Moscow, Mexico City, Los
# Angeles, London and Las Vegas all sit at the 4,004,xxx grid cap), before
# treating this headroom as real or raising max_concurrent_channels.
#
# If a big-city night hangs again with no output, check MemoryPeak against
# MemoryHigh FIRST; the fix is a bigger MemoryHigh (or no MemoryHigh at all),
# not a longer city timeout.
#
# Re-validate after a live night and tune:
#   systemctl --user show streetscape-tracker.service -p MemoryPeak -p CPUUsageNSec
Nice=10
MemoryAccounting=true
MemoryHigh=40G
MemoryMax=48G
CPUAccounting=true
# Hard ceiling: never use more than 4 of the host's cores.
CPUQuota=400%
# Relative cgroup weight (default 100). At 50 we yield ~2:1 to a default-weight
# co-tenant WHEN the CPU is contended, but still use the full CPUQuota when the
# box is otherwise idle (as it usually is at 02:00). Cooperative, not a hard cap.
CPUWeight=50
# Note: on makelab2 our data is on a LOCAL ZFS pool, so disk IO IS block-device
# here — add IOWeight= if a night is ever found to compete with NFS serving;
# for now CPU/Memory caps + Nice + CPUWeight are the real levers.
